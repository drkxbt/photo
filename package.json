{
  "name": "@drkxbt/photo",
  "version": "0.1.0",
  "description": "A photo editor in plain TypeScript: crop, turn, flip and straighten, adjust and looks, draw, write and hide, with undo. No dependencies.",
  "license": "MIT",
  "author": "drk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./photo.css": "./photo.css"
  },
  "files": [
    "dist",
    "photo.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\"",
    "demo": "tsc -p tsconfig.json && node demo/serve.js"
  },
  "devDependencies": {
    "typescript": ">=5.4"
  },
  "keywords": [
    "image-editor",
    "photo-editor",
    "crop",
    "image-crop",
    "annotate",
    "filters",
    "pintura-alternative",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drkxbt/photo.git"
  },
  "homepage": "https://drk.vc/source/photo"
}
